# MongoDB Atlas Connection String
# Replace <username> and <password> with your MongoDB Atlas database credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/house_of_memoir?retryWrites=true&w=majority

# Admin Credentials
ADMIN_USER=admin
ADMIN_PASS=admin123

# Port
PORT=8000

# Automated Email Notifications (Gmail SMTP)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
